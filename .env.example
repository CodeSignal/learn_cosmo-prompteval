# Anthropic (session.config.json model: anthropic/…)
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI (session.config.json model: openai/…)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=

# Gemini (session.config.json model: google/…)
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com
# GOOGLE_API_KEY=

# DeepSeek (session.config.json model: deepseek/… or ~deepseek/…)
# Uses the OpenAI SDK with a different base URL and key. The base URL is the API
# root; a trailing /chat/completions is also accepted.
# DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
# DEEPSEEK_API_KEY=

# Optional: HTTP port (default 3000)
# PORT=3000
