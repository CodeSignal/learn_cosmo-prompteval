# Octavus platform connection
OCTAVUS_API_URL=https://octavus.ai
OCTAVUS_API_KEY=oct_sk_your_key_here

# Agent the server talks to: "dev" or "prod". Defaults to "prod" when unset.
# `npm run dev` forces dev; `npm start` uses the default (prod).
#
# For the Prompt Evaluation Simulator, point these IDs at your *separate*
# Prompt Eval Octavus agent (not the Cosmo Tutor production/dev agents).
AGENT_TARGET=prod

# Deployed Prompt Eval agent IDs for each target
# (find them with: npx octavus --env .env list)
OCTAVUS_AGENT_ID_DEV=your_prompt_eval_dev_agent_id
OCTAVUS_AGENT_ID_PROD=your_prompt_eval_prod_agent_id

# Legacy single-agent var. Still honored as a fallback when the target-specific
# ID above is not set, so older .env files keep working without changes.
# OCTAVUS_AGENT_ID=your_prompt_eval_agent_id

# Optional: HTTP port (default 3000)
# PORT=3000
