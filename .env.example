# LLM provider: anthropic (default), openai, or gemini
LLM_PROVIDER=anthropic

# Anthropic (LLM_PROVIDER=anthropic)
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (LLM_PROVIDER=openai)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Gemini (LLM_PROVIDER=gemini)
# GOOGLE_BASE_URL must be HTTPS on an approved Google host:
# generativelanguage.googleapis.com or Vertex AI *-aiplatform.googleapis.com.
# http:// and other hosts are rejected before any request is sent.
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-2.5-flash

# Optional: HTTP port (default 3000)
# PORT=3000
