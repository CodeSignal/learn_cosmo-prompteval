{
  "name": "learn_cosmo-prompteval",
  "version": "1.0.0",
  "description": "Prompt Evaluation Simulator – run prompts across independent Claude API calls and score outputs",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "build": "esbuild public/app.js --bundle --outfile=public/app.bundle.js --format=esm --platform=browser",
    "build:watch": "esbuild public/app.js --bundle --outfile=public/app.bundle.js --format=esm --platform=browser --watch",
    "start": "npm run build && node server.js",
    "start:prod": "npm run build && node server.js",
    "dev": "npm run build && concurrently -k -n client,server -c blue,green \"npm:build:watch\" \"node --watch server.js\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.3",
    "marked-highlight": "^2.2.4",
    "openai": "^7.9.0",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.0",
    "jsdom": "^30.0.1",
    "supertest": "^7.2.2",
    "vitest": "^4.1.6"
  }
}
